# ─────────────────────────────────────────────────────────────────────────────
#  PRCJ Jewellery — Environment Variables
#  Copy this file to .env and fill in all values before running the app.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="PRCJ Jewellery"
APP_VERSION="1.0.0"
ENVIRONMENT=development           # development | staging | production
DEBUG=true

# CRITICAL: Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_RANDOM_HEX_STRING

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://prcj_user:prcj_password@localhost:5432/prcj_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10

# ── CORS (comma-separated list of allowed frontend origins) ───────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Cloudinary (for 8K product images) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=prcj

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password          # Use Gmail App Password, not your real password
EMAILS_FROM_NAME="PRCJ Jewellery"
EMAILS_FROM_EMAIL=noreply@prcj.in

# ── Razorpay (Indian payment gateway) ────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ── First Superadmin (bootstrapped on first startup) ─────────────────────────
FIRST_ADMIN_EMAIL=admin@prcj.in
FIRST_ADMIN_PASSWORD=Admin@PRCJ2025!    # Change immediately after first login
